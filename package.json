{
  "name": "dsh-tool-media",
  "version": "1.0.0",
  "description": "Run ffmpeg from DeepSeek Harness: probe a file, transcode it, extract frames or audio, and compress video to a target size.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "ffmpeg",
    "media",
    "transcode",
    "video",
    "audio",
    "compress",
    "thumbnail"
  ],
  "author": "yuehancn",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuehancn/dsh-tool-media.git"
  },
  "homepage": "https://github.com/yuehancn/dsh-tool-media#readme",
  "bugs": {
    "url": "https://github.com/yuehancn/dsh-tool-media/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "dsh": ">=0.2.0-rc.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-tools": ">=0.2.0-rc.2"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  }
}